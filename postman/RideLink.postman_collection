          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Always log in fresh right before /me so the token is valid and points to an account",
                  "// that exists in the Account Service database right now (old tokens survive DB resets).",
                  "pm.sendRequest({",
                  "  url: pm.environment.get(\"accountUrl\") + \"/api/auth/login\",",
                  "  method: \"POST\",",
                  "  header: {\"Content-Type\": \"application/json\"},",
                  "  body: {mode: \"raw\", raw: JSON.stringify({email: pm.environment.get(\"driverEmail\"), password: pm.environment.get(\"driverPassword\")})}",
                  "}, (err, res) => {",
                  "  if (!err && res.code === 200) {",
                  "    const b = res.json();",
                  "    const t = b.token || b.accessToken || (b.data && b.data.token);",
                  "    if (t) { pm.environment.set(\"driverToken\", String(t).trim()); }",
                  "    const u = b.user || b.account || b;",
                  "    if (u.userId || u.id) { pm.environment.set(\"accountDriverUserId\", u.userId || u.id); }",
                  "  } else {",
                  "    console.warn(\"Fresh login for driver failed: \" + (err || (res.code + \" \" + res.text())));",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "if (code === 200) {",
                  "  const b = pm.response.json();",
                  "  const u = b.user || b.account || b;",
                  "  pm.test(\"Password is never returned\", () => {",
                  "    pm.expect(b).to.not.have.property(\"password\");",
                  "    pm.expect(u).to.not.have.property(\"password\");",
                  "  });",
                  "  pm.test(\"It is the logged-in driver's account\", () => {",
                  "    const expectedId = pm.environment.get(\"accountDriverUserId\");",
                  "    if (expectedId && (u.userId || u.id)) {",
                  "      pm.expect(u.userId || u.id).to.eql(expectedId);",
                  "    } else {",
                  "      pm.expect(JSON.stringify(u).toLowerCase()).to.include(String(pm.environment.get(\"driverEmail\")).toLowerCase());",
                  "    }",
                  "  });",
                  "} else {",
                  "  let claims = null;",
                  "  try {",
                  "    let p = String(pm.environment.get(\"driverToken\") || \"\").split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
                  "    while (p.length % 4) p += \"=\";",
                  "    claims = JSON.parse(atob(p));",
                  "  } catch (e) {}",
                  "  console.error(\"GET /api/users/me (driver) -> \" + code + \" \" + pm.response.text());",
                  "  console.error(\"Claims inside the token that was sent:\", claims);",
                  "  if (code === 500) {",
                  "    console.error(\"The token came from a login made a moment ago, so this 500 is thrown inside the Account Service. Read the stack trace in the account-service console.\");",
                  "  }",
                  "}"
                ]
              }
            }
          ],
