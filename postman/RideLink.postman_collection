          "name": "Create driver profile",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function fixPlaces(raw){",
                  "  const arr = Array.isArray(raw) ? raw : ((raw && (raw.places || raw.data)) || []);",
                  "  const names = arr.map(p => typeof p === \"string\" ? p : (p && (p.name || p.placeName))).filter(Boolean);",
                  "  if (!names.length) return;",
                  "  const match = v => names.find(n => n.toLowerCase() === String(v || \"\").trim().toLowerCase());",
                  "  const avoid = n => [\"galle\", \"matara\"].indexOf(n.toLowerCase()) >= 0;   // kept free for the TUK negative test",
                  "  let pick = match(pm.environment.get(\"pickupPlace\"));",
                  "  let dest = match(pm.environment.get(\"destinationPlace\"));",
                  "  if (!pick) { pick = names.find(n => !avoid(n) && n !== dest) || names[0]; console.log(\"pickupPlace set to \" + pick); }",
                  "  if (!dest || dest === pick) { dest = names.find(n => n !== pick && !avoid(n)) || names.find(n => n !== pick) || dest; console.log(\"destinationPlace set to \" + dest); }",
                  "  pm.environment.set(\"pickupPlace\", pick);",
                  "  if (dest) pm.environment.set(\"destinationPlace\", dest);",
                  "}",
                  "",
                  "// Make sure pickupPlace / destinationPlace are names the Fare service knows (serviceArea uses pickupPlace).",
                  "pm.sendRequest({",
                  "  url: pm.environment.get(\"fareUrl\") + \"/api/fares/places\",",
                  "  method: \"GET\",",
                  "  header: {Authorization: \"Bearer \" + pm.environment.get(\"passengerToken\")}",
                  "}, (err, res) => { if (!err && res.code === 200) { fixPlaces(res.json()); } });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "pm.test(\"Created (201) or already exists (409)\", () => pm.expect(code).to.be.oneOf([201,409]));",
                  "const driverUrl = pm.environment.get(\"driverUrl\");",
                  "const auth = \"Bearer \" + pm.environment.get(\"driverToken\");",
                  "if (code === 201) {",
                  "  pm.environment.set(\"driverId\", pm.response.json().driverId);",
                  "} else if (code === 409) {",
                  "  pm.sendRequest({url: driverUrl + \"/api/drivers/me\", method: \"GET\", header: {Authorization: auth}}, (e, r) => {",
                  "    if (!e && r.code === 200) {",
                  "      pm.environment.set(\"driverId\", r.json().driverId);",
                  "      console.log(\"driverId loaded from existing profile\");",
                  "    } else if (!e && r.code === 404) {",
                  "      // 409 but this driver has no profile: the plate/licence belongs to another driver account. Retry with new ones.",
                  "      pm.environment.set(\"plateNumber\", \"CAB-\" + Math.floor(1000 + Math.random() * 9000));",
                  "      pm.environment.set(\"licenceNumber\", \"B\" + Math.floor(1000000 + Math.random() * 9000000));",
                  "      const body = {",
                  "        licenceNumber: pm.environment.get(\"licenceNumber\"),",
                  "        serviceArea: pm.environment.get(\"pickupPlace\"),",
                  "        vehicle: {plateNumber: pm.environment.get(\"plateNumber\"), type: \"CAR\", model: \"Toyota Axio\", colour: \"White\"}",
                  "      };",
                  "      pm.sendRequest({",
                  "        url: driverUrl + \"/api/drivers/me\", method: \"POST\",",
                  "        header: {\"Content-Type\": \"application/json\", Authorization: auth},",
                  "        body: {mode: \"raw\", raw: JSON.stringify(body)}",
                  "      }, (e2, r2) => {",
                  "        if (!e2 && r2.code === 201) {",
                  "          pm.environment.set(\"driverId\", r2.json().driverId);",
                  "          console.log(\"Driver profile created with plate \" + body.vehicle.plateNumber);",
                  "        } else {",
                  "          console.warn(\"Could not create driver profile: \" + (e2 || (r2.code + \" \" + r2.text())));",
                  "        }",
                  "      });",
                  "    } else {",
                  "      console.warn(\"Could not load driver profile: \" + (e || (r.code + \" \" + r.text())));",
                  "    }",
                  "  });",
                  "} else {",
                  "  console.warn(\"Create driver profile failed (\" + code + \"): \" + pm.response.text());",
                  "}"
                ]
              }
            }
          ],
