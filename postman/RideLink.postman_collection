  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login: refresh passengerToken / driverToken when they are missing, malformed,",
          "// expired, or belong to a different email than the one in the environment.",
          "function claimsOf(t){",
          "  try{",
          "    let p = t.split('.')[1].replace(/-/g,'+').replace(/_/g,'/');",
          "    while (p.length % 4) p += '=';",
          "    return JSON.parse(atob(p));",
          "  }catch(e){ return null; }",
          "}",
          "function needsLogin(tokenVar, emailVar){",
          "  const t = String(pm.environment.get(tokenVar) || '').trim();",
          "  if (!t || t.indexOf('{{') === 0 || t.split('.').length !== 3) return true;",
          "  const c = claimsOf(t);",
          "  if (!c) return true;",
          "  if (c.exp && (c.exp * 1000 - Date.now() < 30000)) return true;",
          "  const email = String(pm.environment.get(emailVar) || '').toLowerCase();",
          "  const tokenEmail = String(c.email || c.sub || '').toLowerCase();",
          "  if (email && tokenEmail.indexOf('@') > 0 && tokenEmail !== email) return true;",
          "  return false;",
          "}",
          "function ensure(tokenVar, emailVar, passVar){",
          "  if (!needsLogin(tokenVar, emailVar)) return;",
          "  const email = pm.environment.get(emailVar), pass = pm.environment.get(passVar), base = pm.environment.get('accountUrl');",
          "  if (!email || !pass || !base) return;",
          "  pm.sendRequest({",
          "    url: base + '/api/auth/login',",
          "    method: 'POST',",
          "    header: {'Content-Type': 'application/json'},",
          "    body: {mode: 'raw', raw: JSON.stringify({email: email, password: pass})}",
          "  }, (err, res) => {",
          "    if (!err && res.code === 200){",
          "      const b = res.json();",
          "      const tok = b.token || b.accessToken || (b.data && b.data.token);",
          "      if (tok){ pm.environment.set(tokenVar, String(tok).trim()); console.log(tokenVar + ' refreshed automatically'); }",
          "    } else {",
          "      console.warn('Auto-login failed for ' + email + ' (' + (err || res.code) + ') - run \"0. Setup\" first');",
          "    }",
          "  });",
          "}",
          "const path = pm.request.url.getPath();",
          "if (!path.startsWith('/api/auth/')){      // do not interfere with register/login requests",
          "  ensure('passengerToken', 'passengerEmail', 'passengerPassword');",
          "  ensure('driverToken', 'driverEmail', 'driverPassword');",
          "}"
        ]
      }
    }
